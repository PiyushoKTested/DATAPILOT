# DataPilot configuration Ã¢â‚¬â€ copy to backend/.env and edit as needed.
# Every value has a working default; the app runs with no .env file at all.

# Database Ã¢â‚¬â€ SQLite by default (no install needed).
# PostgreSQL example:
# DATAPILOT_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/datapilot
DATAPILOT_DATABASE_URL=sqlite:///./data/datapilot.db

# JWT signing key. Auto-generated if unset. Set a strong value in production.
# DATAPILOT_SECRET_KEY=change-me-to-a-long-random-string

# Upload ceiling in megabytes
DATAPILOT_MAX_UPLOAD_MB=100

# Optional local LLM (Ollama). The app works fully without it.
DATAPILOT_OLLAMA_ENABLED=true
DATAPILOT_OLLAMA_URL=http://127.0.0.1:11434
DATAPILOT_OLLAMA_MODEL=llama3.2


